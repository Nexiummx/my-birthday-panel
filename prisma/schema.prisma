// Esquema de datos — plataforma de invitaciones digitales
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// La URL de conexión vive en prisma7.config.ts (Prisma 7 ya no la lee desde el
// esquema): las migraciones usan DIRECT_URL y la app usa DATABASE_URL vía el
// driver adapter de node-postgres.
datasource db {
  provider = "postgresql"
}

/// Estado de una invitación / respuesta.
enum InvitationStatus {
  PENDING
  CONFIRMED
  DECLINED
}

/// Estética de la experiencia pública. Cada valor tiene su paleta, sus
/// tipografías y su escena en src/lib/themes.ts.
enum EventTheme {
  BOSQUE
  VAQUEROS
  BARBIE
  DISCO
}

/// Cuenta del panel. Es el titular: todo evento cuelga de una cuenta y las
/// consultas del panel se filtran siempre por ella.
///
/// Es también el modelo de usuario de Better Auth. Las credenciales NO viven
/// aquí: la contraseña y los proveedores sociales están en Account, que es
/// como Better Auth permite tener varias formas de entrar a la misma cuenta.
model AdminUser {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String   @default("")
  emailVerified Boolean  @default(false)
  image         String?
  /// Créditos de evento comprados, en total y para siempre. Lo sube el
  /// superadmin cuando el cliente paga. Por defecto 0: quien se registra por su
  /// cuenta no puede crear nada hasta que se le habilite.
  eventQuota    Int      @default(0)
  /// Créditos consumidos. Solo sube. Crear un evento lo incrementa, y ni
  /// archivarlo ni borrarlo lo devuelve: si no fuera así, un cliente podría
  /// pagar una vez y estrenar evento cada año archivando el anterior.
  /// Devolver un crédito es subir eventQuota, que deja rastro.
  eventsUsed    Int      @default(0)
  /// Solo las cuentas internas: pueden dar de alta cuentas y mover cupos.
  isSuperAdmin  Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  events   Event[]
  sessions Session[]
  accounts Account[]
  tickets  Ticket[]

  @@map("admin_users")
}

/// Sesión activa. Better Auth las guarda en base, no en un JWT autocontenido:
/// así una sesión puede revocarse de verdad.
model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// Una forma de entrar a una cuenta: contraseña ("credential") o un proveedor
/// social. Una misma cuenta puede tener varias.
model Account {
  id                    String    @id @default(cuid())
  /// Id del usuario en el proveedor. Para "credential" es el propio userId.
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  /// Solo para providerId = "credential".
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

/// Contador de peticiones por clave. Vive en base y no en memoria a propósito:
/// en un despliegue sin servidor cada instancia tiene su propia memoria, así
/// que un contador en RAM no limita casi nada.
model RateLimit {
  id          String  @id @default(cuid())
  key         String?
  /// Peticiones dentro de la ventana actual.
  count       Int?
  /// Marca de tiempo en MILISEGUNDOS: no cabe en un Int de 32 bits, de ahí
  /// BigInt. Los campos van opcionales para coincidir con lo que espera el
  /// adaptador de Better Auth.
  lastRequest BigInt?

  @@index([key])
  @@map("rate_limits")
}

/// Tokens de un solo uso: verificación de correo y restablecimiento de
/// contraseña.
model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

/// Evento al que pertenecen las invitaciones.
model Event {
  id      String @id @default(cuid())
  ownerId String

  name            String
  date            DateTime
  time            String
  location        String
  locationUrl     String?
  dressCode       String?
  dressCodeUrl    String?
  description     String?
  invitationImage String?

  theme EventTheme @default(BOSQUE)

  /// Textos de la pantalla de bienvenida (la que se ve antes de abrir la
  /// invitación). NULL = se usa el texto por defecto del tema.
  sealedEyebrow  String?
  sealedHeadline String?
  sealedCta      String?

  /// Fecha con la que se creó el evento. Ancla la ventana de cambio: la fecha
  /// solo puede moverse al mes anterior o al siguiente de esta. No se toca
  /// nunca, ni siquiera cuando `date` cambia.
  originalDate  DateTime
  /// Cuándo se usó el único cambio de fecha permitido. NULL = sigue disponible.
  /// Para cualquier otro movimiento el cliente abre un ticket.
  dateChangedAt DateTime?

  /// Archivar solo saca el evento de la vista: no devuelve el crédito.
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner       AdminUser    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  invitations Invitation[]
  tickets     Ticket[]

  @@index([ownerId])
  @@map("events")
}

/// Invitación individual: una URL pública por invitado.
model Invitation {
  id              String           @id @default(cuid())
  eventId         String
  slug            String           @unique
  guestName       String
  guestCount      Int              @default(1)
  status          InvitationStatus @default(PENDING)
  personalMessage String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  /// Una invitación solo puede tener un RSVP activo.
  rsvp  Rsvp?

  @@index([eventId])
  @@index([status])
  @@map("invitations")
}

/// Respuesta del invitado. Relación 1:1 con la invitación.
model Rsvp {
  id           String           @id @default(cuid())
  invitationId String           @unique
  status       InvitationStatus
  guestCount   Int              @default(0)
  comment      String?
  respondedAt  DateTime         @default(now())
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@map("rsvps")
}

/// Estado de un ticket. ANSWERED es "le toca al cliente": separa la bandeja
/// del equipo (lo que falta contestar) de lo que ya se contestó.
enum TicketStatus {
  OPEN
  ANSWERED
  CLOSED
}

/// De qué va el ticket. DATE_CHANGE es el que abre el propio panel cuando el
/// cliente choca con la regla de la fecha.
enum TicketCategory {
  DATE_CHANGE
  BILLING
  EVENT
  OTHER
}

/// Conversación entre un cliente y el equipo.
///
/// Existe porque hay reglas que el panel no puede resolver solo —mover la fecha
/// más allá de un mes, pedir otro crédito— y sin un canal dentro del producto
/// esas peticiones se pierden en WhatsApp.
model Ticket {
  id      String  @id @default(cuid())
  ownerId String
  /// Evento al que se refiere, si aplica. SetNull y no Cascade: el ticket es la
  /// prueba de lo que se pidió y debe sobrevivir a que el evento se borre.
  eventId String?

  category TicketCategory @default(OTHER)
  subject  String
  status   TicketStatus   @default(OPEN)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner    AdminUser       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  event    Event?          @relation(fields: [eventId], references: [id], onDelete: SetNull)
  messages TicketMessage[]

  @@index([ownerId])
  @@index([status])
  @@map("tickets")
}

/// Cada intervención en un ticket, del cliente o del equipo.
model TicketMessage {
  id       String @id @default(cuid())
  ticketId String

  /// true = lo escribió el equipo. Se guarda plano en vez de apuntar a la
  /// cuenta autora para que el hilo siga legible si esa cuenta desaparece.
  fromTeam    Boolean @default(false)
  authorEmail String
  body        String

  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("ticket_messages")
}
